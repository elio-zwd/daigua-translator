{
  "name": "daigua-translator",
  "displayName": "呆瓜翻译器",
  "description": "MCU C/C++ 代码本地知识包翻译，未命中时回退到 Bing。用于 MTranCode 自定义翻译服务。",
  "version": "0.3.0",
  "icon": "./images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "translateSource"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "translates": [
      {
        "translate": "daigua",
        "title": "呆瓜翻译器（本地知识包）"
      }
    ],
    "configuration": {
      "title": "呆瓜翻译器",
      "properties": {
        "daiguaTranslate.packPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "知识包 JSON 绝对路径列表。同名候选全部显示。可运行“呆瓜翻译器：选择知识包文件”免手写配置。",
          "scope": "window"
        },
        "daiguaTranslate.bingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "本地未命中时使用 Bing 联网翻译。关闭后立即报告未命中，不发起新的联网请求。MTranCode 已有缓存不受此开关影响。",
          "scope": "window",
          "order": 2
        },
        "daiguaTranslate.bingTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 30000,
          "description": "每次等待 Bing 结果的上限（毫秒）。超时后停止等待；底层翻译库不提供请求取消接口，已发起请求可能继续执行。",
          "scope": "window",
          "order": 3
        },
        "daiguaTranslate.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "知识包文件保存后自动重新加载（合并 250 毫秒内的连续文件事件）。加载失败保留上次有效内容。",
          "scope": "window",
          "order": 4
        },
        "daiguaTranslate.includeParameters": {
          "type": "boolean",
          "default": true,
          "description": "将函数 parameters 中已有中文说明的参数加入本地查询，例如 arg；同名参数全部显示并标注所属函数。不会修改知识包文件。",
          "scope": "window",
          "order": 5
        },
        "daiguaTranslate.localHover": {
          "type": "boolean",
          "default": true,
          "description": "在 C/C++ 符号上直接显示带“呆瓜 · 本地知识包”标题的悬停说明。仅查本地，绕过 MTranCode 缓存，无需切换翻译源；其他插件的悬停内容可能同时显示。",
          "scope": "window",
          "order": 6
        },
        "daiguaTranslate.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示有效词条数和 Bing 状态；点击打开快捷设置。",
          "scope": "window",
          "order": 7
        }
      }
    },
    "commands": [
      {
        "command": "daiguaTranslate.reloadPacks",
        "title": "呆瓜翻译器：重新加载知识包"
      },
      {
        "command": "daiguaTranslate.quickSettings",
        "title": "呆瓜翻译器：快捷设置"
      },
      {
        "command": "daiguaTranslate.choosePacks",
        "title": "呆瓜翻译器：选择知识包文件"
      },
      {
        "command": "daiguaTranslate.showStatus",
        "title": "呆瓜翻译器：查看加载诊断"
      },
      {
        "command": "daiguaTranslate.queryLocal",
        "title": "呆瓜翻译器：本地查询"
      }
    ],
    "menus": {
      "editor/context": [
        { "command": "daiguaTranslate.queryLocal", "group": "navigation@20", "when": "editorTextFocus" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test",
    "package": "npm test && node ../scripts/test-plugin.js && vsce package --out daigua-translator.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "bing-translate-api": "^2.9.1"
  },
  "publisher": "elio-zwd",
  "repository": {
    "type": "git",
    "url": "https://github.com/elio-zwd/daigua-translator.git"
  },
  "bugs": {
    "url": "https://github.com/elio-zwd/daigua-translator/issues"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
