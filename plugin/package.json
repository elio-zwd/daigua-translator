{
  "name": "daigua-translator",
  "displayName": "呆瓜翻译器",
  "description": "独立 MCU C/C++ 代码知识查询、文本翻译、离线词典与音标学习。",
  "version": "0.4.1",
  "icon": "./images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "translation",
    "MCU",
    "C++",
    "dictionary",
    "phonetic"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "呆瓜翻译器",
      "properties": {
        "daiguaTranslate.packPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "知识包 JSON 绝对路径列表。同名候选全部显示。可运行“呆瓜翻译器：选择知识包文件”免手写配置。",
          "scope": "window"
        },
        "daiguaTranslate.bingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "允许 Bing 联网翻译。关闭后不发起新的联网请求；名称改查离线词典，普通句子无法联网翻译。",
          "scope": "window",
          "order": 2
        },
        "daiguaTranslate.bingTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 30000,
          "description": "每次等待 Bing 结果的上限（毫秒）。超时后停止等待；底层翻译库不提供请求取消接口，已发起请求可能继续执行。",
          "scope": "window",
          "order": 3
        },
        "daiguaTranslate.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "知识包文件保存后自动重新加载（合并 250 毫秒内的连续文件事件）。加载失败保留上次有效内容。",
          "scope": "window",
          "order": 4
        },
        "daiguaTranslate.includeParameters": {
          "type": "boolean",
          "default": true,
          "description": "将函数 parameters 中已有中文说明的参数加入本地查询，例如 arg；同名参数全部显示并标注所属函数。不会修改知识包文件。",
          "scope": "window",
          "order": 5
        },
        "daiguaTranslate.localHover": {
          "type": "boolean",
          "default": true,
          "description": "在 C/C++ 名称上显示呆瓜悬停。本地知识包优先，未收录名称按悬停模式处理。其他插件的悬停可能同时显示。",
          "scope": "window",
          "order": 6
        },
        "daiguaTranslate.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示有效词条数和 Bing 状态；点击打开快捷设置。",
          "scope": "window",
          "order": 7
        },
        "daiguaTranslate.hoverFallback": {
          "type": "string",
          "enum": [
            "online",
            "ecdict",
            "off"
          ],
          "enumDescriptions": [
            "自动联网释义，失败后回退离线词典",
            "仅使用离线技术库和 ECDICT",
            "关闭未收录名称的自动释义"
          ],
          "default": "online",
          "description": "未收录名称的自动悬停模式；只影响悬停，主动翻译仍受 Bing 总开关约束。",
          "scope": "window",
          "order": 8
        },
        "daiguaTranslate.dictionaryPath": {
          "type": "string",
          "default": "",
          "description": "由 phonetics/tool.py index 生成、包含 manifest.json 的本地 ECDICT 索引目录。运行时不读取 CSV。",
          "scope": "window",
          "order": 9
        },
        "daiguaTranslate.technicalLibraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外技术库或项目补充 JSON 的绝对路径。后者优先于前者，均优先于内置技术库和 ECDICT。修改后运行重新加载知识包以刷新。",
          "scope": "window",
          "order": 10
        }
      }
    },
    "commands": [
      {
        "command": "daiguaTranslate.reloadPacks",
        "title": "呆瓜翻译器：重新加载知识包"
      },
      {
        "command": "daiguaTranslate.quickSettings",
        "title": "呆瓜翻译器：快捷设置"
      },
      {
        "command": "daiguaTranslate.choosePacks",
        "title": "呆瓜翻译器：选择知识包文件"
      },
      {
        "command": "daiguaTranslate.showStatus",
        "title": "呆瓜翻译器：查看加载诊断"
      },
      {
        "command": "daiguaTranslate.queryLocal",
        "title": "呆瓜翻译器：本地查询"
      },
      {
        "command": "daiguaTranslate.translateSelection",
        "title": "呆瓜翻译器：翻译选区或当前名称"
      },
      {
        "command": "daiguaTranslate.translateText",
        "title": "呆瓜翻译器：输入文本翻译"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "daiguaTranslate.queryLocal",
          "group": "navigation@20",
          "when": "editorTextFocus"
        },
        {
          "command": "daiguaTranslate.translateSelection",
          "group": "navigation@19",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test",
    "package": "npm test && node ../scripts/test-plugin.js && vsce package --out daigua-translator.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "bing-translate-api": "^2.9.1"
  },
  "publisher": "elio-zwd",
  "repository": {
    "type": "git",
    "url": "https://github.com/elio-zwd/daigua-translator.git"
  },
  "bugs": {
    "url": "https://github.com/elio-zwd/daigua-translator/issues"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
